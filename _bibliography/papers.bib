@inproceedings{korade2026tonic,
  title={Induced Mood Shift and Cognitive Adaptation During Free Play in a Changing Tonic Context},
  author={Korade, Soham and Pochampally, Suswara and Saroja, TK},
  month = may,
  year={2026},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  address={Barcelona, Spain},
  pages={22062--22066},
  doi={10.1109/ICASSP55912.2026.11464162},
  url={https://ieeexplore.ieee.org/document/11464162},
  abstract={Understanding how individuals create music freely, without inhibitions, can provide valuable insights into their cognitive functions and emotional regulation. This study presents an interactive experiment examining how tonic perception affects musical expression and emotional engagement during free play. Participants interacted with a touch-based pitch slider while a continuous drone served as the tonal background. The drone's tonic shifted randomly among the notes of a pentatonic scale at regular intervals, altering the perceived tonal context. Pitch trajectories and self-reported experiences were collected. Analysis revealed that changes in tonic influenced free play patterns, while subjective reports reflected differences in mood, enjoyment, and sense of creative control. Sentiment analysis of open-ended feedback indicated experiences of calmness, curiosity, and familiarity with melodic structures. The findings suggest that even short-term interactions involving tonic modulation can produce meaningful emotional and behavioral changes. This also demonstrates the potential of touch-based interfaces as tools for studying embodied musical cognition and expressive behavior.},
  preview={tonic-free-play.png},
  selected={true}
}

@inproceedings{korade2024raga,
  title={Raga Space Visualization: Analyzing Melodic Structures in Carnatic and Hindustani Music},
  author={Korade, Soham and Pochampally, Suswara and Saroja, TK},
  month = nov,
  booktitle = "Proceedings of the 3rd Workshop on NLP for Music and Audio (NLP4MusA)",
  year={2024},
  journal={Proceedings of the 3rd Workshop on NLP for Music and Audio (NLP4MusA)},
  volume={},
  number={},
  pages={57--61},
  publisher = "Association for Computational Lingustics",
  url = "https://aclanthology.org/2024.nlp4musa-1.10/",
  abstract={The concept of raga in Indian classical music serves as a complex, multifaceted melodic entity that can be approached through various perspectives. Compositions within a raga act as foundational structures, serving as the bedrock for improvisations. Analyzing their textual notations is easier and more objective in comparison with analyzing audio samples. A significant amount of musical insights can be derived from the discrete swara sequences alone. This paper aims to construct an intuitive visualization of raga space, using swara sequences from raga compositions. Notations from public sources are normalized, and their TF-IDF features are projected into a low-dimensional space. This approach allows for qualitative analysis of both Carnatic and Hindustani ragas, mapping them to known raga theory.},
  poster={https://drive.google.com/file/d/188pZdjx1ATHY7VhkvRzgKiUxR0yUzozT/view?usp=share_link},
  slides={https://drive.google.com/file/d/18s-thgsM1QImV_VJue7PAXFmThPPwf9z/view?usp=share_link},
  pdf={https://aclanthology.org/2024.nlp4musa-1.10.pdf},
  preview={ragaspace.png},
  selected={true}
}

@article{duggirala2024telugu,
  title={Graphic Complexity and Orthographic Neighbors: Observations based on Telugu Writing System},
  author={Duggirala, Vasanta and Bapi, Raju Surampudi and Korade, Soham G.},
  month = oct,
  year={2024},
  journal={Grapholinguistics in the 21st century—From graphemes to knowledge},
  volume={},
  number={},
  pages={},
  publisher={},
  url={https://grafematik2024.sciencesconf.org/},
  video={https://youtu.be/svIqANksvbw?si=IFQW8ZLOcGBrNRlb},
  abstract={Telugu script makes use of an orthographic syllable known as akshara as its basic unit. We have designed a computer program that calculates four different parameters of graphic complexity for Telugu aksharas: Perimetric complexity, number of connected points, number of disconnected points, and number of simple strokes. With the help of an algorithm, we have also calculated orthographic neighbors for 200 words classified as simple, moderately complex, and complex based on their syllable structure and estimated graphic complexity. In this paper, we will present our results pertaining to graphic complexity and its relationship to orthographic neighborhood size.},
  preview={graphcom.png},
  selected={true}
}

@article{korade2024notation,
  title={A Notation Dataset for Indian Raga Music},
  author={Korade, Soham and Pochampally, Suswara},
  month = apr,
  year={2025},
  journal={Satellite Workshop: Workshop on Indian Music Analysis and Generative Applications (WIMAGA), ICASSP},
  volume={},
  number={},
  pages={},
  publisher={},
  url={},
  abstract={Indian raga music requires a symbolic notation dataset to support music information retrieval (MIR) tasks. With the growing applications of generative artificial intelligence, text-based datasets can be especially valuable, as these models excel when inputted structured symbolic data. A high-level analysis of ragas is difficult from audio data. In this article, we announce our new dataset called InRaMu. Notations of raga-based compositions in Hindustani, Carnatic and Rabindra Sangeet were scraped from the Internet. The compiled dataset consists of 7 sources combined to get 2,295 compositions in 337 ragas. Total number of compositions, with 976,826 individual notes, correspond to a combined playback duration of about 16,280 minutes. Special care was taken during data preprocessing such as filtering of compositions to ensure raga accuracy. This article provides the overview of dataset format, and provides statistical information, along with potential applications of the dataset.},
  preview={raga-dataset.png},
  selected={true}
}
